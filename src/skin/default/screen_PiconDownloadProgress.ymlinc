screen:
  backgroundColor: "md_transparent"
  name: "PiconDownloadProgress"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Dialog.ymlinc"
        position: "510,365"
        dialog_height: "350"
        dialog_width: "900"
    - widget:
        font: "$md_body_large"
        halign: "left"
        name: "operation"
        position: "14,74"
        size: "872,40"
        transparent: "1"
        valign: "center"
    - widget:
        name: "slider1"
        position: "14,126"
        size: "872,20"
    - widget:
        font: "$md_body_large"
        halign: "left"
        name: "name"
        position: "14,160"
        size: "872,40"
        transparent: "1"
        valign: "center"
    - widget:
        font: "$md_body_large"
        halign: "left"
        name: "status"
        position: "14,215"
        size: "872,40"
        transparent: "1"
        valign: "center"
