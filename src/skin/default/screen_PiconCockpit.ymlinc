screen:
  backgroundColor: "md_transparent"
  name: "PiconCockpit"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window_Wide.ymlinc"
        position: "252,111"
    - widget:
        alphatest: "blend"
        name: "preview"
        position: "1116,78"
        scale: "1"
        size: "280,168"
        zPosition: "2"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        foregroundColorSelected: "$foregroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "14,74"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1086,675"
        source: "list"
        children:
          - convert:
              type: "COCTemplatedMultiContentEx"
              cell:
                itemHeight: 45
                fonts:
                  - "$md_body_large"
                fields:
                  - text:
                      position: "10,0"
                      size: "e-20,45"
                      font: "$md_body_large"
                      flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                      value: 0
