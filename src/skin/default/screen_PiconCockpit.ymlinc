screen:
  name: "PiconCockpit"
  position: "center,center"
  size: "1280,720"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        alphatest: "blend"
        name: "preview"
        position: "e-20-280,65"
        scale: "1"
        size: "280,168"
        zPosition: "2"
    - widget:
        backgroundColorSelected: "$backgroundColorSelected"
        itemCornerRadiusSelected: "$radius_item"
        position: "20,65"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "e-340,570"
        source: "list"
        children:
          - convert:
              type: "TemplatedMultiContentEx"
              cell:
                itemHeight: 30
                fonts:
                  - "$caption_font"
                fields:
                  - text:
                      position: "10,0"
                      size: "e-20,30"
                      font: "$caption_font"
                      flags: RT_HALIGN_LEFT|RT_VALIGN_CENTER
                      value: 0
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
